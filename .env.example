# Rumbo has no build step, so nothing here is required to run the app: the
# public Supabase URL and publishable key live directly in assets/api.js and are
# meant to be public. Row level security is what protects the data.
#
# These variables exist for anyone forking the project against their own
# Supabase instance, or adding a build step later.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# NEVER put the service role key in this file, in the repository, or anywhere a
# browser can reach. It bypasses row level security entirely.
# SUPABASE_SERVICE_ROLE_KEY=  <-- do not do this
